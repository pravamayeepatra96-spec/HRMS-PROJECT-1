      /* Blur + Color Overlay */
      body::before {
        content: "";
        position: absolute;
        width: 100%;
        height: 100%;

        background: rgba(35 13 104 / 60%); /* your color */
        backdrop-filter: blur(8px);

        z-index: 0;
      }

      .main-container {
        position: relative;
        z-index: 1;
        flex: 1;
        display: flex;
        justify-content: center;
        align-items: center;
      }

      /* Glass Card */
      .auth-card {
        width: 400px;
        padding: 30px;
        border-radius: 15px;
        background: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(12px);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
        color: #fff;
      }

      .title {
        text-align: center;
        margin-bottom: 20px;
        font-weight: bold;
      }

      .form-control {
        background: transparent;
        border: none;
        border-bottom: 1px solid #fff;
        border-radius: 0;
        color: #fff;
      }

      .form-control::placeholder {
        color: rgba(255, 255, 255, 0.7);
      }

      .form-control:focus {
        background: transparent;
        box-shadow: none;
        border-bottom: 2px solid #fff;
        color: #fff;
      }

      .btn-main {
        background: #fff;
        color: #000;
        border-radius: 25px;
      }

      .toggle-text {
        text-align: center;
        margin-top: 15px;
        cursor: pointer;
        font-size: 14px;
      }

      .hidden {
        display: none;
      }

      /* Responsive */
@media(max-width:768px){
  .form-card {
    width: 90%;
  }
}